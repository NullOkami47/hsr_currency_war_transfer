# Shared only by the Vercel API and the administrator worker. Use at least
# 32 random bytes in production; never expose this value in browser code.
CURRENCY_WAR_WORKER_TOKEN=replace-with-a-long-random-secret

# Vercel API setting: the worker's authenticated job endpoint.
CURRENCY_WAR_WORKER_URL=https://worker.example.com/jobs

# Vercel API setting used only to sign in to /admin and sign its short-lived
# HTTP-only session cookie. Generate a different random 32-byte value; do not
# reuse the worker token and do not expose it in browser code.
CURRENCY_WAR_ADMIN_TOKEN=replace-with-a-different-long-random-secret

# Alternative to a raw administrator token: a server-side PBKDF2-SHA256 hash
# in pbkdf2_sha256$iterations$base64url-salt$base64url-hash format. The browser
# still accepts the original password; never commit a real value.
# CURRENCY_WAR_ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$...$...

# Optional second factor for /admin. Generate an independent Base32 secret with
# `npm run admin:totp:generate`, add it to Google Authenticator, then store only
# the unspaced setup key in the Vercel environment. Never commit the real key.
# CURRENCY_WAR_ADMIN_TOTP_SECRET=BASE32SETUPKEY

# Optional stable secret used to HMAC client network addresses before a rate-
# limit key is sent to the worker. Falls back to CURRENCY_WAR_WORKER_TOKEN.
# CURRENCY_WAR_CLIENT_HASH_SECRET=replace-with-another-random-secret

# Only for a non-Vercel reverse proxy that overwrites X-Forwarded-For. Leaving
# this off prevents clients from choosing their own rate-limit identity.
# CURRENCY_WAR_TRUST_PROXY=1

# Worker settings. Bind to 127.0.0.1 behind a TLS reverse proxy, or use
# 0.0.0.0 only when the VM firewall and HTTPS ingress are configured.
CURRENCY_WAR_WORKER_HOST=127.0.0.1
CURRENCY_WAR_WORKER_PORT=8787
CURRENCY_WAR_HEADLESS=1

# Optional first-run bootstrap. The safe default keeps public submissions off;
# prefer enabling and configuring policy through /admin. Local-stack startup
# enables submissions on loopback for development only.
# CURRENCY_WAR_PUBLIC_SUBMISSIONS=1
# CURRENCY_WAR_SOURCE_ALLOWLIST_ENABLED=1

# Optional persistent paths and editable text limits.
# CURRENCY_WAR_PROFILE_DIR=D:\currency-war\browser-profile
# CURRENCY_WAR_STATE_PATH=D:\currency-war\transfers.json
# CURRENCY_WAR_JOB_STATE_PATH=D:\currency-war\jobs.json
# CURRENCY_WAR_TITLE_LIMIT=60
# CURRENCY_WAR_DESCRIPTION_LIMIT=800
