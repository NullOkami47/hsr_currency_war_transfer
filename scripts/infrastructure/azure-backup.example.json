{
  "service": "hsr-transfer-worker.service",
  "endpoint": "http://127.0.0.1:8787/",
  "environmentFile": "/etc/hsr-transfer-worker.env",
  "paths": {
    "transfers": "/var/lib/hsr-transfer-worker/transfers.json",
    "jobs": "/var/lib/hsr-transfer-worker/jobs.json",
    "security": "/var/lib/hsr-transfer-worker/jobs.json.security.json"
  },
  "publicKeyPath": "/etc/hsr-backup/recipient-public.pem",
  "backupDirectory": "/var/lib/hsr-worker-backups",
  "backupUser": "azureuser"
}
