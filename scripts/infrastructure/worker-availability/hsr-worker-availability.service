[Unit]
Description=Independent read-only HSR worker availability probe
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hsr-availability
Group=hsr-availability
SupplementaryGroups=
WorkingDirectory=/opt/hsr-worker-availability
ExecStart=/opt/node-v24.22.3-linux-x64/bin/node /opt/hsr-worker-availability/server.mjs
LoadCredential=probe-username:/etc/hsr-worker-availability/probe-username
LoadCredential=probe-password:/etc/hsr-worker-availability/probe-password
Restart=on-failure
RestartSec=5s
TimeoutStartSec=10s
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
LimitNOFILE=128
TasksMax=32
MemoryMax=128M
CPUQuota=20%
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
