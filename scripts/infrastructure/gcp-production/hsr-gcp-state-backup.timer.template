[Unit]
Description=OFFLINE BLOCKED daily GCP backup proposal independent of Windows PC
ConditionPathExists=/etc/hsr-gcp-production/EXPLICIT_GO

[Timer]
OnCalendar=*-*-* 19:00:00 UTC
Persistent=true
Unit=hsr-gcp-state-backup.service
# 03:00 HKT daily. No Install section and no activation performed.
# A stopped VM misses this timer: an external owner-scoped monitor must alert independently.
