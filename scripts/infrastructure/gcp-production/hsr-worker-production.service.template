[Unit]
Description=OFFLINE BLOCKED HSR GCP production worker proposal
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/hsr-gcp-production/EXPLICIT_GO
# No Install section. This task does not create the GO marker or install/start/enable units.

[Service]
Type=simple
User=hsr-worker
Group=hsr-worker
WorkingDirectory=/opt/hsr-transfer-worker-staging
EnvironmentFile=/etc/hsr-gcp-production/worker.env
Environment=HOME=/var/lib/hsr-transfer-worker-staging/home
Environment=XDG_CONFIG_HOME=/var/lib/hsr-transfer-worker-staging/home/.config
Environment=XDG_CACHE_HOME=/var/lib/hsr-transfer-worker-staging/home/.cache
# BLOCKER: a separately reviewed preflight must verify pinned VM/receipt/0700 owner,
# reject all active profile/session/Chrome owners and acquire the shared session lock.
# flock alone does NOT implement these checks. Do not delete this false to make green.
# Future reviewed profile preflight must use /opt/node-v24.22.3-linux-x64/bin/node.
ExecStartPre=/usr/bin/false
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /var/lib/hsr-transfer-worker-staging/login/.production-worker.flock /opt/node-v24.22.3-linux-x64/bin/node /opt/hsr-transfer-worker-staging/scripts/worker-server.mjs
Restart=no
RuntimeMaxSec=3600
TimeoutStopSec=240s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@@STATE_DIRECTORY@@ /var/lib/hsr-transfer-worker-staging/login /var/lib/hsr-transfer-worker-staging/home
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryAccounting=true
CPUAccounting=true
TasksMax=256
StandardOutput=journal
StandardError=journal
# The current publisher omits chromiumSandbox:true; explicit sandbox launch is a blocker.
# Linux systemd/Chrome/resource acceptance is not yet done. Keep the false preflight.
