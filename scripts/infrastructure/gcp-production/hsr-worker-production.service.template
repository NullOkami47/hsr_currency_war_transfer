[Unit]
Description=OFFLINE BLOCKED HSR GCP production worker proposal
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/hsr-gcp-production/EXPLICIT_GO
# No Install section. This task does not create the GO marker or install/start/enable units.

[Service]
Type=simple
User=hsr-worker
Group=hsr-worker
WorkingDirectory=/opt/hsr-transfer-worker-staging
EnvironmentFile=/etc/hsr-gcp-production/worker.env
Environment=HOME=/var/lib/hsr-transfer-worker-staging/home
Environment=XDG_CONFIG_HOME=/var/lib/hsr-transfer-worker-staging/home/.config
Environment=XDG_CACHE_HOME=/var/lib/hsr-transfer-worker-staging/home/.cache
# Verifies pinned VM identity, non-root hsr-worker owner, absence of Chrome/worker locks,
# and quiescent 3-file production state before acquiring the shared session flock.
ExecStartPre=/opt/node-v24.22.3-linux-x64/bin/node /opt/hsr-transfer-worker-staging/scripts/infrastructure/gcp-production-profile-preflight.mjs /etc/hsr-gcp-production/worker-preflight.json
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /var/lib/hsr-transfer-worker-staging/login/.production-worker.flock /opt/node-v24.22.3-linux-x64/bin/node /opt/hsr-transfer-worker-staging/scripts/worker-server.mjs
Restart=no
RuntimeMaxSec=3600
TimeoutStopSec=240s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@@STATE_DIRECTORY@@ /var/lib/hsr-transfer-worker-staging/login /var/lib/hsr-transfer-worker-staging/home
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryAccounting=true
CPUAccounting=true
TasksMax=256
StandardOutput=journal
StandardError=journal
# Explicit Chromium sandbox is enforced in publisher/worker-server; Linux runtime acceptance
# (systemd, Chrome sandbox, resource limits, and EXPLICIT_GO) still remains pending.
