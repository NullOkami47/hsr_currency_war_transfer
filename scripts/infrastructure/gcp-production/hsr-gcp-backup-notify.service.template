[Unit]
Description=OFFLINE BLOCKED bounded GCP backup failure metadata notification proposal
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/hsr-gcp-production/EXPLICIT_GO
# No OnFailure on this notifier: avoid recursion; no worker restart or admission reset.

[Service]
Type=oneshot
User=root
# Exports only allowlisted phase/health/result fields to the GCP-specific event prefix.
ExecStart=/opt/node-v24.22.3-linux-x64/bin/node /opt/hsr-transfer-worker-staging/scripts/infrastructure/gcp-backup-failure-notify.mjs /etc/hsr-gcp-production/backup.json
Restart=no
TimeoutStartSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StandardOutput=journal
StandardError=journal
