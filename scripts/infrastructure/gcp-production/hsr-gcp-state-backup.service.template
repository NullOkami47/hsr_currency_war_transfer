[Unit]
Description=OFFLINE BLOCKED GCP-native encrypted three-file backup proposal
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/hsr-gcp-production/EXPLICIT_GO
OnFailure=hsr-gcp-backup-notify.service
# Must not call azure-blob-backup.mjs or the Azure-MI-authenticated gcs-backup client.

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hsr-transfer-worker-staging
# BLOCKER: reviewed GCP metadata-token immutable uploader/coordinator wrapper is not implemented.
# Intended reuse is coordinatedBackup + worker-state-backup, with the existing ancestor flock.
# Future reviewed backup command must use /opt/node-v24.22.3-linux-x64/bin/node.
ExecStart=/usr/bin/false
Restart=no
TimeoutStartSec=30min
TimeoutStopSec=240s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hsr-worker-backups-gcp-production /var/lib/hsr-worker-backup-control /run
# Deliberately no Install/SuccessExitStatus/failure recovery that starts a publisher.
