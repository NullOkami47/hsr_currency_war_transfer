[Unit]
Description=OFFLINE BLOCKED GCP-native encrypted three-file backup proposal
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/hsr-gcp-production/EXPLICIT_GO
OnFailure=hsr-gcp-backup-notify.service
# Must not call azure-blob-backup.mjs or the Azure-MI-authenticated gcs-backup client.

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hsr-transfer-worker-staging
# Acquires the ancestor backup flock before running the GCP-native metadata-token uploader.
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/hsr-worker-backup.flock /usr/bin/env HSR_BACKUP_FLOCK_HELD=1 /opt/node-v24.22.3-linux-x64/bin/node /opt/hsr-transfer-worker-staging/scripts/infrastructure/gcp-native-backup.mjs /etc/hsr-gcp-production/backup.json
Restart=no
TimeoutStartSec=30min
TimeoutStopSec=240s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hsr-worker-backups-gcp-production /var/lib/hsr-worker-backup-control /run
# Deliberately no Install/SuccessExitStatus/failure recovery that starts a publisher.
