[Unit]
Description=HSR synthetic staging worker (never production publishing)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=hsr-worker
Group=hsr-worker
WorkingDirectory=/opt/hsr-transfer-worker-staging
EnvironmentFile=/etc/hsr-worker-synthetic.env
Environment=HOME=/var/lib/hsr-transfer-worker-staging/home
Environment=XDG_CONFIG_HOME=/var/lib/hsr-transfer-worker-staging/home/.config
Environment=XDG_CACHE_HOME=/var/lib/hsr-transfer-worker-staging/home/.cache
ExecStart=/usr/bin/node /opt/hsr-transfer-worker-staging/scripts/infrastructure/synthetic-worker-server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hsr-transfer-worker-staging
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryAccounting=true
CPUAccounting=true
TasksMax=256
RuntimeMaxSec=3600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
