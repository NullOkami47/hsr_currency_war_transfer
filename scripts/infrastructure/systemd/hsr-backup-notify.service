[Unit]
Description=Export encrypted-backup failure metadata to independent monitoring
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/node /opt/hsr-backup/backup-failure-notify.mjs
TimeoutStartSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
