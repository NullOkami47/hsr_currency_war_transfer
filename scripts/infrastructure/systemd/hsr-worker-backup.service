[Unit]
Description=Coordinated encrypted HSR state backup and Azure Blob delivery
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hsr-transfer-worker
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/hsr-worker-backup.flock /usr/bin/env HSR_BACKUP_FLOCK_HELD=1 /usr/bin/node /opt/hsr-transfer-worker/scripts/infrastructure/azure-blob-backup.mjs /etc/hsr-backup/backup.json
TimeoutStartSec=30min
TimeoutStopSec=240s
UMask=0077
StateDirectory=hsr-worker-backup-control
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hsr-worker-backups /var/lib/hsr-worker-backup-control /run

[Install]
WantedBy=multi-user.target
